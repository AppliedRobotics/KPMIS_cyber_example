/*
  Робототехнический контроллер «Кибернетический»: циклы и плоттер

  Цикл for рисует в плоттере синусоиду и «пилу».
  Откройте Инструменты → Плоттер по последовательному соединению, скорость 115200.

  Плата в Arduino IDE: Arduino Uno. Кабель USB-C — в ВЕРХНИЙ разъём (Arduino).
  DIP-переключатель: DIP1 и DIP4 = OFF.
*/

void setup() {
  Serial.begin(115200);
}

void loop() {
  for (int i = 0; i < 100; i++) {         // i = 0, 1, 2 … 99
    float s = sin(i * 0.1);               // синусоида от -1 до 1
    float saw = (i % 20) / 10.0 - 1;      // «пила»: остаток от деления на 20
    Serial.print("sin:");
    Serial.print(s);
    Serial.print(" saw:");                // подпись:значение — отдельная линия графика
    Serial.println(saw);
    delay(30);
  }
}
